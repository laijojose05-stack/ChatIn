<%- include('partials/head', { title: 'ChatIn — Messages', isChat: true }) %>

<div class="chat-app-container" id="chatApp">
  <!-- 1. LEFT SIDEBAR -->
  <aside class="sidebar-wrapper" id="sidebar">
    <!-- Sidebar Header -->
    <div class="sidebar-header d-flex align-items-center justify-content-between px-3">
      <div class="brand-badge d-flex align-items-center gap-2">
        <img src="/logo.svg" alt="ChatIn" width="26" height="26">
        <span class="brand-text fw-bold">ChatIn</span>
        <span class="status-dot" id="socketStatusDot" title="Connecting to live stream..."></span>
      </div>

      <div class="d-flex align-items-center gap-1">
        <button class="btn btn-icon" id="openNewChatBtn" title="New Direct Message">
          <i class="bi bi-plus-lg"></i>
        </button>
        <button class="btn btn-icon" id="openNewGroupBtn" title="New Group Hub">
          <i class="bi bi-people"></i>
        </button>
      </div>
    </div>

    <!-- Search Box -->
    <div class="search-box-wrapper px-3 py-2">
      <div class="search-input-wrap">
        <i class="bi bi-search search-icon"></i>
        <input type="text" id="conversationSearchInput" class="form-control form-control-sm search-input" placeholder="Search conversations...">
      </div>
    </div>

    <!-- Filter Pills -->
    <div class="filter-tabs px-3 pb-2 d-flex gap-2">
      <button class="filter-pill active" data-filter="all">All</button>
      <button class="filter-pill" data-filter="direct">Direct</button>
      <button class="filter-pill" data-filter="group">Groups</button>
      <button class="filter-pill" data-filter="unread">Unread</button>
    </div>

    <!-- Conversations List (WhatsApp style: always loaded without blank loading screen) -->
    <div class="conversations-list flex-grow-1 overflow-y-auto" id="conversationsContainer">
      <div id="conversationsList"></div>
    </div>

    <!-- User Profile Footer -->
    <div class="sidebar-footer p-3 border-top d-flex align-items-center justify-content-between">
      <div class="user-meta d-flex align-items-center gap-2 overflow-hidden cursor-pointer" id="userProfilePill" title="Open Settings">
        <div class="user-avatar-circle" id="userAvatarCircle">
          <% if (user.profilePicture) { %>
            <img src="<%= user.profilePicture %>" alt="<%= user.username %>" class="w-100 h-100 rounded-circle object-fit-cover">
          <% } else { %>
            <%= user.username.substring(0, 2).toUpperCase() %>
          <% } %>
        </div>
        <div class="user-info-text text-truncate">
          <div class="user-name fw-semibold small text-truncate" id="sidebarUsernameDisplay"><%= user.username %></div>
          <div class="user-sub text-muted extra-small">Online</div>
        </div>
      </div>

      <div class="d-flex align-items-center gap-1">
        <button class="btn btn-icon" id="openSettingsBtn" title="Settings">
          <i class="bi bi-gear"></i>
        </button>
        <button class="btn btn-icon" id="themeToggleBtn" title="Toggle Theme">
          <i class="bi bi-sun" id="themeIcon"></i>
        </button>
        <a href="/logout" class="btn btn-icon text-danger" title="Sign Out">
          <i class="bi bi-box-arrow-right"></i>
        </a>
      </div>
    </div>
  </aside>

  <!-- 2. MAIN CHAT AREA -->
  <main class="chat-main-area" id="mainChatArea">
    <!-- Placeholder / Empty State -->
    <div class="empty-chat-state d-flex flex-column align-items-center justify-content-center h-100 text-center p-4" id="emptyChatState">
      <div class="empty-icon-wrap mb-3">
        <img src="/logo.svg" alt="ChatIn" width="64" height="64">
      </div>
      <h3 class="fw-bold mb-2">Welcome to ChatIn</h3>
      <p class="text-muted small max-w-sm mb-4">
        Select a conversation from the sidebar or start a new direct message or group hub.
      </p>
      <button class="btn chatin-btn-gradient rounded-pill px-4 py-2" id="emptyNewChatBtn">
        <i class="bi bi-plus-lg me-1"></i> Start New Conversation
      </button>
    </div>

    <!-- Active Conversation View -->
    <div class="active-chat-wrapper d-none flex-column h-100" id="activeChatWrapper">
      <!-- Chat Header -->
      <header class="chat-header px-3 py-2 border-bottom d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2 overflow-hidden min-w-0" style="min-width: 0;">
          <button class="btn btn-icon d-md-none flex-shrink-0" id="mobileBackBtn" title="Back to conversations" aria-label="Back">
            <i class="bi bi-arrow-left fs-5"></i>
          </button>
          <div class="chat-target-avatar flex-shrink-0" id="activeChatAvatar"></div>
          <div class="overflow-hidden min-w-0" style="min-width: 0;">
            <div class="active-chat-name fw-semibold text-truncate" id="activeChatName">Conversation</div>
            <div class="active-chat-status extra-small text-muted text-truncate" id="activeChatStatus">Active</div>
          </div>
        </div>

        <div class="d-flex align-items-center gap-1 flex-shrink-0">
          <button class="btn btn-icon call-header-btn" id="headerAudioCallBtn" title="Start voice call" aria-label="Audio Call">
            <i class="bi bi-telephone text-success"></i>
          </button>
          <button class="btn btn-icon call-header-btn" id="headerVideoCallBtn" title="Start video call" aria-label="Video Call">
            <i class="bi bi-camera-video text-primary"></i>
          </button>
          <button class="btn btn-icon" id="chatSearchToggleBtn" title="Search in conversation">
            <i class="bi bi-search"></i>
          </button>
          <button class="btn btn-icon" id="chatInfoBtn" title="Contact Details & Shared Media">
            <i class="bi bi-info-circle"></i>
          </button>
        </div>
      </header>

      <!-- In-Chat Search Bar -->
      <div class="in-chat-search-bar px-3 py-2 border-bottom d-none align-items-center justify-content-between bg-body-tertiary" id="inChatSearchBar">
        <div class="d-flex align-items-center gap-2 flex-grow-1 me-2 overflow-hidden min-w-0">
          <i class="bi bi-search text-muted small flex-shrink-0"></i>
          <input type="text" id="inChatSearchInput" class="form-control form-control-sm border-0 bg-transparent p-0" placeholder="Find in messages..." autocomplete="off">
        </div>
        <div class="d-flex align-items-center gap-1 flex-shrink-0">
          <span class="extra-small text-muted me-1" id="searchMatchCount">0 matches</span>
          <button type="button" class="btn btn-sm btn-icon" id="searchPrevBtn" title="Previous match"><i class="bi bi-chevron-up"></i></button>
          <button type="button" class="btn btn-sm btn-icon" id="searchNextBtn" title="Next match"><i class="bi bi-chevron-down"></i></button>
          <button type="button" class="btn-close btn-close-white small ms-1" id="closeSearchBtn" aria-label="Close search"></button>
        </div>
      </div>

      <!-- Message History List -->
      <div class="messages-viewport flex-grow-1 p-3 overflow-y-auto position-relative" id="messagesViewport">
        <div class="messages-stream d-flex flex-column gap-2" id="messagesStream"></div>

        <!-- Floating Scroll-to-Bottom Button -->
        <button class="btn btn-floating-bottom d-none rounded-circle shadow-lg" id="scrollToBottomBtn" title="Scroll to bottom">
          <i class="bi bi-chevron-down fs-5"></i>
          <span class="unread-scroll-badge d-none" id="unreadScrollBadge">0</span>
        </button>
      </div>

      <!-- Typing Indicator Row -->
      <div class="typing-indicator-row px-4 py-1 extra-small text-muted d-none" id="typingIndicator">
        <span class="typing-text"></span>
      </div>

      <!-- Message Input Bar -->
      <footer class="message-composer-bar p-3 border-top">
        <!-- Reply Bar -->
        <div class="reply-preview-bar px-3 py-2 mb-2 d-none align-items-center justify-content-between rounded-3 border-start border-4 border-primary bg-body-tertiary" id="replyBar">
          <div class="d-flex flex-column overflow-hidden me-2 min-w-0">
            <div class="extra-small fw-bold text-primary d-flex align-items-center gap-1">
              <i class="bi bi-reply-fill"></i> <span id="replySenderName">Replying</span>
            </div>
            <div class="reply-text-preview extra-small text-muted text-truncate" id="replyTextPreview">Message text</div>
          </div>
          <button type="button" class="btn-close btn-close-white small flex-shrink-0" id="cancelReplyBtn" aria-label="Cancel reply"></button>
        </div>

        <!-- Audio Recording Bar -->
        <div class="audio-record-bar px-3 py-2 mb-2 d-none align-items-center justify-content-between rounded-3 bg-danger bg-opacity-10 border border-danger border-opacity-25" id="audioRecordBar">
          <div class="d-flex align-items-center gap-2">
            <span class="record-pulse-dot"></span>
            <span class="small fw-semibold text-danger">Recording Audio Note...</span>
            <span class="extra-small font-monospace text-danger fw-bold ms-1" id="recordTimer">0:00</span>
          </div>
          <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" id="cancelRecordBtn">Cancel</button>
            <button type="button" class="btn btn-sm btn-danger rounded-pill px-3 fw-bold" id="sendRecordBtn"><i class="bi bi-send-fill me-1"></i> Send</button>
          </div>
        </div>

        <!-- Emoji Popover -->
        <div class="emoji-popover d-none shadow-lg rounded-3" id="emojiPopover">
          <div class="emoji-tabs p-2 border-bottom d-flex gap-2">
            <button class="emoji-tab-btn active" data-category="smileys">😀 Smileys</button>
            <button class="emoji-tab-btn" data-category="gestures">👍 Hands</button>
            <button class="emoji-tab-btn" data-category="hearts">❤️ Hearts</button>
            <button class="emoji-tab-btn" data-category="objects">🔥 Cool</button>
          </div>
          <div class="emoji-grid p-2" id="emojiGrid"></div>
        </div>

        <!-- Attachment Preview Bar -->
        <div class="attachment-preview-bar px-2 py-1 mb-2 d-none align-items-center justify-content-between rounded-2 bg-body-tertiary" id="attachmentPreview">
          <div class="d-flex align-items-center gap-2 overflow-hidden">
            <i class="bi bi-paperclip text-primary"></i>
            <span class="attachment-name small text-truncate" id="attachmentName">file.png</span>
          </div>
          <button class="btn-close btn-close-white small" id="removeAttachmentBtn" aria-label="Remove attachment"></button>
        </div>

        <form id="messageForm" class="d-flex align-items-center gap-2">
          <button type="button" class="btn btn-icon" id="emojiToggleBtn" title="Add Emoji">
            <i class="bi bi-emoji-smile"></i>
          </button>

          <label class="btn btn-icon mb-0" title="Attach file or photo">
            <i class="bi bi-paperclip"></i>
            <input type="file" id="fileInput" class="d-none">
          </label>

          <button type="button" class="btn btn-icon text-muted" id="micBtn" title="Record Voice Note">
            <i class="bi bi-mic"></i>
          </button>

          <div class="input-wrap flex-grow-1">
            <input type="text" id="messageInput" class="form-control composer-input" placeholder="Type a message... (Press Enter to send)" autocomplete="off">
          </div>

          <button type="submit" class="btn btn-send chatin-btn-gradient" id="sendBtn" title="Send message">
            <i class="bi bi-send-fill"></i>
          </button>
        </form>
      </footer>
    </div>
  </main>
</div>

<!-- MODAL 1: NEW DIRECT MESSAGE / USER SEARCH -->
<div class="modal fade" id="newChatModal" tabindex="-1" aria-labelledby="newChatModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content chatin-modal rounded-4 shadow">
      <div class="modal-header border-bottom">
        <h5 class="modal-title fw-bold" id="newChatModalLabel">
          <i class="bi bi-person-plus me-1 text-primary"></i> New Direct Chat
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <div class="mb-3">
          <label class="form-label small fw-semibold">Search by Username</label>
          <div class="input-group">
            <span class="input-group-text bg-transparent text-muted"><i class="bi bi-search"></i></span>
            <input type="text" id="userSearchModalInput" class="form-control" placeholder="Type exact username or email..." autocomplete="off">
          </div>
          <div class="extra-small text-muted mt-1">Users appear only when their username is entered completely and correctly.</div>
        </div>
        <div class="search-results-list" id="userSearchResults">
          <div class="text-center text-muted small py-4">
            <i class="bi bi-person-search fs-3 d-block mb-2 text-secondary"></i>
            Enter an exact username to find a user.
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- MODAL 2: NEW GROUP CHAT -->
<div class="modal fade" id="newGroupModal" tabindex="-1" aria-labelledby="newGroupModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content chatin-modal rounded-4 shadow">
      <div class="modal-header border-bottom">
        <h5 class="modal-title fw-bold" id="newGroupModalLabel">
          <i class="bi bi-people me-1 text-primary"></i> Create Group Hub
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <form id="createGroupForm">
          <div class="mb-3">
            <label class="form-label small fw-semibold">Group Name *</label>
            <input type="text" id="groupNameInput" class="form-control" placeholder="e.g. Design Team" required maxlength="50">
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold">Description</label>
            <input type="text" id="groupDescInput" class="form-control" placeholder="What is this group about?" maxlength="120">
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold">Add Members</label>
            <input type="text" id="groupMemberSearch" class="form-control form-control-sm mb-2" placeholder="Search members...">
            <div class="member-select-list border rounded p-2" id="groupMemberList" style="max-height: 180px; overflow-y: auto;">
              <div class="text-muted small text-center py-2">Loading users...</div>
            </div>
          </div>
          <button type="submit" class="btn chatin-btn-gradient w-100 py-2 rounded-3 fw-semibold">Create Group</button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- MODAL: CONTACT INFO & SHARED MEDIA (P2P CHAT) -->
<div class="modal fade" id="contactInfoModal" tabindex="-1" aria-labelledby="contactInfoModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content chatin-modal rounded-4 shadow-lg overflow-hidden border">
      <div class="modal-header border-bottom px-4 py-3">
        <h5 class="modal-title fw-bold mb-0" id="contactInfoModalLabel">Contact Details</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4 text-center">
        <!-- Contact Avatar & Status -->
        <div class="contact-info-avatar-holder mx-auto mb-3 position-relative" style="width:78px;height:78px;">
          <div class="user-avatar-circle w-100 h-100 fs-3 shadow-md" id="contactInfoAvatar">CI</div>
          <span class="status-dot connected position-absolute bottom-0 end-0 p-2 border border-2 border-dark" id="contactInfoStatusDot"></span>
        </div>
        <h5 class="fw-bold mb-1 text-truncate" id="contactInfoName">Contact Name</h5>
        <div class="text-muted extra-small mb-2 text-truncate" id="contactInfoEmail">email@example.com</div>
        <div class="badge bg-body-tertiary text-secondary px-3 py-1 mb-3 rounded-pill extra-small" id="contactInfoStatus">Active Now</div>

        <!-- Contact Bio -->
        <div class="p-3 rounded-3 bg-body-tertiary text-start mb-3 border">
          <div class="extra-small text-muted fw-bold text-uppercase mb-1">About / Status</div>
          <div class="small" id="contactInfoBio">Hey there! I am using ChatIn.</div>
        </div>

        <!-- Shared Media Tab -->
        <div class="text-start mb-3">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="extra-small text-muted fw-bold text-uppercase">Shared Photos & Media</span>
            <span class="extra-small text-muted" id="sharedMediaCount">0 files</span>
          </div>
          <div class="shared-media-grid d-flex gap-2 overflow-x-auto py-1" id="sharedMediaGrid" style="min-height:50px;">
            <div class="text-muted extra-small py-2 text-center w-100">No photos or files shared yet.</div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex flex-column gap-2 pt-2 border-top">
          <button type="button" class="btn btn-outline-secondary rounded-3 py-2 d-flex align-items-center justify-content-center gap-2" id="contactCopyUsernameBtn">
            <i class="bi bi-clipboard"></i> Copy Username
          </button>
          <button type="button" class="btn btn-outline-danger rounded-3 py-2 d-flex align-items-center justify-content-center gap-2" id="contactClearChatBtn">
            <i class="bi bi-trash3"></i> Clear Chat History
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- MODAL 3: PROFESSIONAL MASTER-DETAIL WORKSPACE & ACCOUNT SETTINGS -->
<div class="modal fade" id="settingsModal" tabindex="-1" aria-labelledby="settingsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered settings-modal-dialog">
    <div class="modal-content chatin-modal rounded-4 shadow-lg overflow-hidden border">
      <!-- Modal Header -->
      <div class="modal-header border-bottom px-3 py-2 py-md-3 px-md-4 d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2 overflow-hidden min-w-0" style="min-width: 0;">
          <button class="btn btn-icon d-md-none flex-shrink-0 d-none" id="settingsMobileBackBtn" title="Back to Settings menu" aria-label="Back">
            <i class="bi bi-chevron-left fs-5"></i>
          </button>
          <div class="feature-icon-box p-0 mb-0 rounded-3 bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center flex-shrink-0" id="settingsHeaderIconBox" style="width:34px;height:34px;">
            <i class="bi bi-gear-wide-connected fs-5"></i>
          </div>
          <div class="overflow-hidden min-w-0" style="min-width: 0;">
            <h5 class="modal-title fw-bold mb-0 lh-1 text-truncate" id="settingsModalLabel">Settings</h5>
            <span class="extra-small text-muted text-truncate d-none d-sm-block" id="settingsModalSub">Manage your account and preferences</span>
          </div>
        </div>
        <button type="button" class="btn-close flex-shrink-0" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <!-- Master-Detail Body -->
      <div class="modal-body p-0 settings-modal-body">
        <!-- 1. Left Navigation Menu (WhatsApp/iOS style on Mobile, Sidebar on Desktop) -->
        <div class="settings-sidebar-nav p-3" id="settingsSidebarNav">
          <!-- Mobile Profile Hero Tap (opens profile detail) -->
          <div class="settings-mobile-profile-hero d-md-none p-3 mb-3 rounded-4 d-flex align-items-center gap-3 cursor-pointer settings-nav-item" data-settings-tab="#pane-profile" data-settings-title="My Profile">
            <div class="user-avatar-circle flex-shrink-0" style="width:48px;height:48px;font-size:1.1rem;">
              <% if (user.profilePicture) { %>
                <img src="<%= user.profilePicture %>" alt="<%= user.username %>" class="w-100 h-100 rounded-circle object-fit-cover">
              <% } else { %>
                <%= user.username.substring(0, 2).toUpperCase() %>
              <% } %>
            </div>
            <div class="flex-grow-1 overflow-hidden min-w-0" style="min-width:0;">
              <div class="fw-bold fs-6 text-truncate"><%= user.username %></div>
              <div class="extra-small text-muted text-truncate"><%= user.email %></div>
              <div class="extra-small text-primary mt-1"><i class="bi bi-pencil-square me-1"></i>Edit Profile</div>
            </div>
            <i class="bi bi-chevron-right text-muted flex-shrink-0"></i>
          </div>

          <div class="extra-small text-muted text-uppercase fw-bold px-2 mb-2 tracking-wider">Account</div>
          <div class="nav flex-column gap-1 mb-3">
            <button class="settings-nav-item active" data-settings-tab="#pane-profile" data-settings-title="My Profile" type="button">
              <i class="bi bi-person-badge"></i>
              <span>My Profile</span>
              <i class="bi bi-chevron-right ms-auto d-md-none text-muted extra-small"></i>
            </button>
            <button class="settings-nav-item" data-settings-tab="#pane-security" data-settings-title="Security & Access" type="button">
              <i class="bi bi-shield-lock"></i>
              <span>Security & Access</span>
              <i class="bi bi-chevron-right ms-auto d-md-none text-muted extra-small"></i>
            </button>
          </div>

          <div class="extra-small text-muted text-uppercase fw-bold px-2 mb-2 tracking-wider">Preferences</div>
          <div class="nav flex-column gap-1 mb-3">
            <button class="settings-nav-item" data-settings-tab="#pane-appearance" data-settings-title="Appearance & Theme" type="button">
              <i class="bi bi-palette"></i>
              <span>Appearance & Theme</span>
              <i class="bi bi-chevron-right ms-auto d-md-none text-muted extra-small"></i>
            </button>
            <button class="settings-nav-item" data-settings-tab="#pane-sound" data-settings-title="Sounds & Alerts" type="button">
              <i class="bi bi-bell"></i>
              <span>Sounds & Alerts</span>
              <i class="bi bi-chevron-right ms-auto d-md-none text-muted extra-small"></i>
            </button>
            <button class="settings-nav-item" data-settings-tab="#pane-shortcuts" data-settings-title="Chat & Shortcuts" type="button">
              <i class="bi bi-keyboard"></i>
              <span>Chat & Shortcuts</span>
              <i class="bi bi-chevron-right ms-auto d-md-none text-muted extra-small"></i>
            </button>
            <button class="settings-nav-item" data-settings-tab="#pane-system" data-settings-title="System Telemetry" type="button">
              <i class="bi bi-cpu"></i>
              <span>System Telemetry</span>
              <i class="bi bi-chevron-right ms-auto d-md-none text-muted extra-small"></i>
            </button>
          </div>

          <!-- Bottom User Mini Pill -->
          <div class="mt-auto pt-3 border-top border-secondary border-opacity-10 d-flex align-items-center gap-2 px-2">
            <div class="user-avatar-circle" style="width:32px;height:32px;font-size:0.75rem;">
              <% if (user.profilePicture) { %>
                <img src="<%= user.profilePicture %>" alt="<%= user.username %>" class="w-100 h-100 rounded-circle object-fit-cover">
              <% } else { %>
                <%= user.username.substring(0, 2).toUpperCase() %>
              <% } %>
            </div>
            <div class="flex-grow-1 overflow-hidden">
              <div class="fw-semibold extra-small text-truncate"><%= user.username %></div>
              <div class="text-success extra-small d-flex align-items-center gap-1">
                <span class="status-dot connected" style="width:6px;height:6px;"></span> Pro Active
              </div>
            </div>
          </div>
        </div>

        <!-- 2. Right Content Pane -->
        <div class="settings-content-pane">
          <div class="tab-content" id="settingsTabPanes">
            <!-- PANE 1: MY PROFILE -->
            <div class="tab-pane fade show active" id="pane-profile" role="tabpanel">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <div>
                  <h5 class="fw-bold mb-1">My Profile</h5>
                  <p class="text-muted small mb-0">Manage your avatar, display handle, and public status</p>
                </div>
              </div>

              <div id="profileAlert" class="alert d-none py-2 px-3 small rounded-3 mb-3"></div>

              <!-- Profile Form Encompassing Avatar and Fields -->
              <form id="profileForm">
                <!-- Profile Cover Banner & Avatar -->
                <div class="settings-card p-0 overflow-hidden mb-4">
                  <div class="settings-profile-banner"></div>
                  <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 px-3 pb-3">
                    <div class="d-flex align-items-center gap-3">
                      <div class="settings-avatar-holder position-relative" title="Click to upload profile photo">
                        <div id="settingsAvatarDisplay" class="w-100 h-100">
                          <% if (user.profilePicture) { %>
                            <img src="<%= user.profilePicture %>" alt="<%= user.username %>" id="settingsAvatarImg" class="w-100 h-100 object-fit-cover">
                          <% } else { %>
                            <div class="w-100 h-100 d-flex align-items-center justify-content-center text-white fw-bold fs-4">
                              <%= user.username.substring(0, 2).toUpperCase() %>
                            </div>
                          <% } %>
                        </div>
                        <label for="settingsAvatarInput" class="settings-avatar-overlay cursor-pointer" title="Upload new photo">
                          <i class="bi bi-camera fs-5"></i>
                        </label>
                      </div>
                      <!-- File input separate from preview to avoid DOM destruction on change -->
                      <input type="file" id="settingsAvatarInput" name="profilePicture" accept="image/*" class="d-none">

                      <div class="mb-1">
                        <div class="fw-bold fs-6"><%= user.username %></div>
                        <div class="extra-small text-muted"><%= user.email %></div>
                      </div>
                    </div>
                    <label for="settingsAvatarInput" class="btn btn-sm btn-outline-primary rounded-pill px-3 cursor-pointer mb-1">
                      <i class="bi bi-upload me-1"></i> Change Photo
                    </label>
                  </div>
                </div>

                <div class="settings-card">
                  <div class="mb-3">
                    <label for="settingsUsername" class="form-label small fw-semibold">Username Handle</label>
                    <div class="input-group custom-input-group">
                      <span class="input-group-text border-end-0"><i class="bi bi-at"></i></span>
                      <input type="text" id="settingsUsername" class="form-control border-start-0" value="<%= user.username %>" required minlength="3" maxlength="30">
                    </div>
                    <div class="extra-small text-muted mt-1">Letters, numbers, and underscores only (3-30 chars).</div>
                  </div>

                  <div class="mb-3">
                    <label for="settingsEmail" class="form-label small fw-semibold">Email Address</label>
                    <div class="input-group custom-input-group">
                      <span class="input-group-text border-end-0"><i class="bi bi-envelope"></i></span>
                      <input type="email" id="settingsEmail" class="form-control border-start-0 text-muted" value="<%= user.email %>" readonly disabled>
                      <span class="input-group-text bg-transparent text-success border-start-0 small"><i class="bi bi-patch-check-fill me-1"></i> Verified</span>
                    </div>
                  </div>

                  <div class="mb-0">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                      <label for="settingsBio" class="form-label small fw-semibold mb-0">About / Status Bio</label>
                      <span class="extra-small text-muted" id="bioCharCounter">0 / 150</span>
                    </div>
                    <textarea id="settingsBio" class="form-control" rows="3" maxlength="150" placeholder="Tell your teammates what you are working on..."><%= user.bio || 'Hey there! I am using ChatIn.' %></textarea>
                  </div>
                </div>

                <div class="d-flex justify-content-end mb-2">
                  <button type="submit" id="saveProfileBtn" class="btn chatin-btn-gradient px-4 py-2 rounded-3 fw-semibold">
                    <span id="saveProfileText">Save Changes</span>
                    <span id="saveProfileSpinner" class="spinner-border spinner-border-sm ms-2 d-none" role="status"></span>
                  </button>
                </div>
              </form>
            </div>

            <!-- PANE 2: SECURITY & CREDENTIALS -->
            <div class="tab-pane fade" id="pane-security" role="tabpanel">
              <div class="mb-3">
                <h5 class="fw-bold mb-1">Security & Access</h5>
                <p class="text-muted small mb-0">Manage password security and active authentication sessions</p>
              </div>

              <div id="passwordAlert" class="alert d-none py-2 px-3 small rounded-3 mb-3"></div>

              <!-- Security Status Overview -->
              <div class="settings-card d-flex align-items-center justify-content-between mb-3">
                <div class="d-flex align-items-center gap-3">
                  <div class="feature-icon-box p-0 mb-0 rounded-3 bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center" style="width:42px;height:42px;">
                    <i class="bi bi-shield-check fs-4"></i>
                  </div>
                  <div>
                    <div class="fw-bold small">Account Security Status</div>
                    <div class="extra-small text-muted">Stateless 256-bit JWT Session • bcrypt salted password hashing</div>
                  </div>
                </div>
                <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill small">Protected</span>
              </div>

              <!-- Password Change Form -->
              <form id="changePasswordForm">
                <div class="settings-card mb-3">
                  <div class="fw-bold small mb-3"><i class="bi bi-key me-1 text-primary"></i> Change Password</div>

                  <div class="mb-3">
                    <label for="currentPasswordInput" class="form-label small fw-semibold">Current Password</label>
                    <div class="input-group custom-input-group">
                      <span class="input-group-text border-end-0"><i class="bi bi-lock"></i></span>
                      <input type="password" id="currentPasswordInput" class="form-control border-start-0 border-end-0" placeholder="Enter current password" required autocomplete="current-password">
                      <button class="btn border-start-0" type="button" id="toggleCurrentPassword" title="Show/Hide">
                        <i class="bi bi-eye" id="eyeIconCurrent"></i>
                      </button>
                    </div>
                  </div>

                  <div class="mb-3">
                    <label for="newPasswordInput" class="form-label small fw-semibold">New Password</label>
                    <div class="input-group custom-input-group">
                      <span class="input-group-text border-end-0"><i class="bi bi-shield-lock"></i></span>
                      <input type="password" id="newPasswordInput" class="form-control border-start-0 border-end-0" placeholder="Minimum 6 characters" required minlength="6" autocomplete="new-password">
                      <button class="btn border-start-0" type="button" id="toggleNewPassword" title="Show/Hide">
                        <i class="bi bi-eye" id="eyeIconNew"></i>
                      </button>
                    </div>
                  </div>

                  <div class="mb-0">
                    <label for="confirmNewPasswordInput" class="form-label small fw-semibold">Confirm New Password</label>
                    <div class="input-group custom-input-group">
                      <span class="input-group-text border-end-0"><i class="bi bi-check-circle"></i></span>
                      <input type="password" id="confirmNewPasswordInput" class="form-control border-start-0 border-end-0" placeholder="Re-enter new password" required minlength="6" autocomplete="new-password">
                      <button class="btn border-start-0" type="button" id="toggleConfirmNewPassword" title="Show/Hide">
                        <i class="bi bi-eye" id="eyeIconConfirmNew"></i>
                      </button>
                    </div>
                  </div>
                </div>

                <div class="d-flex justify-content-end mb-4">
                  <button type="submit" id="updatePasswordBtn" class="btn chatin-btn-gradient px-4 py-2 rounded-3 fw-semibold">
                    <span id="updatePasswordText">Update Password</span>
                    <span id="updatePasswordSpinner" class="spinner-border spinner-border-sm ms-2 d-none" role="status"></span>
                  </button>
                </div>
              </form>

              <!-- Active Session Card -->
              <div class="settings-card">
                <div class="fw-bold small mb-2"><i class="bi bi-laptop me-1 text-info"></i> Active Session</div>
                <div class="d-flex align-items-center justify-content-between p-2 rounded bg-body-tertiary">
                  <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-browser-chrome fs-5 text-primary"></i>
                    <div>
                      <div class="extra-small fw-semibold">Current Browser Session</div>
                      <div class="extra-small text-muted">Windows • Node / Socket.IO Engine</div>
                    </div>
                  </div>
                  <span class="badge bg-success bg-opacity-25 text-success extra-small">Active Now</span>
                </div>
              </div>
            </div>

            <!-- PANE 3: APPEARANCE & THEMES -->
            <div class="tab-pane fade" id="pane-appearance" role="tabpanel" tabindex="0">
              <div class="mb-3">
                <h5 class="fw-bold mb-1">Appearance & Themes</h5>
                <p class="text-muted small mb-0">Customize visual theme, accent colors, and chat density</p>
              </div>

              <!-- Theme Cards Selector -->
              <div class="settings-card mb-4">
                <div class="fw-bold small mb-3"><i class="bi bi-brush me-1 text-primary"></i> Color Mode</div>
                <div class="row g-3">
                  <div class="col-sm-6">
                    <div class="theme-card-option" id="cardThemeDark">
                      <div class="theme-card-preview" style="background: #0b0f19;">
                        <div class="preview-sidebar" style="background: #111625; border-right: 1px solid rgba(255,255,255,0.08);"></div>
                        <div class="preview-body">
                          <div class="preview-bar" style="background: #6366f1; width: 60%;"></div>
                          <div class="preview-bar" style="background: #1c2438; width: 85%;"></div>
                          <div class="preview-bar" style="background: #1c2438; width: 45%;"></div>
                        </div>
                      </div>
                      <div class="d-flex align-items-center justify-content-between">
                        <div>
                          <div class="fw-bold small">Obsidian Dark</div>
                          <div class="extra-small text-muted">Deep slate & obsidian dark contrast</div>
                        </div>
                        <i class="bi bi-check-circle-fill text-primary fs-5" id="checkIconDark"></i>
                      </div>
                    </div>
                  </div>

                  <div class="col-sm-6">
                    <div class="theme-card-option" id="cardThemeLight">
                      <div class="theme-card-preview" style="background: #f4f6fa;">
                        <div class="preview-sidebar" style="background: #ffffff; border-right: 1px solid rgba(0,0,0,0.08);"></div>
                        <div class="preview-body">
                          <div class="preview-bar" style="background: #6366f1; width: 60%;"></div>
                          <div class="preview-bar" style="background: #e2e8f0; width: 85%;"></div>
                          <div class="preview-bar" style="background: #e2e8f0; width: 45%;"></div>
                        </div>
                      </div>
                      <div class="d-flex align-items-center justify-content-between">
                        <div>
                          <div class="fw-bold small">Crisp Light</div>
                          <div class="extra-small text-muted">High-clarity clean light surfaces</div>
                        </div>
                        <i class="bi bi-circle text-muted fs-5" id="checkIconLight"></i>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Accent Color Palette -->
              <div class="settings-card mb-4">
                <div class="fw-bold small mb-2"><i class="bi bi-droplet-half me-1 text-primary"></i> Workspace Accent Color</div>
                <div class="d-flex align-items-center gap-3">
                  <div class="accent-color-pill active" style="background: #6366f1;" data-color="#6366f1" title="Indigo (Default)"></div>
                  <div class="accent-color-pill" style="background: #8b5cf6;" data-color="#8b5cf6" title="Violet"></div>
                  <div class="accent-color-pill" style="background: #10b981;" data-color="#10b981" title="Emerald"></div>
                  <div class="accent-color-pill" style="background: #0ea5e9;" data-color="#0ea5e9" title="Sky Cyan"></div>
                  <div class="accent-color-pill" style="background: #f43f5e;" data-color="#f43f5e" title="Rose"></div>
                </div>
              </div>

              <!-- Chat Density -->
              <div class="settings-card">
                <div class="d-flex align-items-center justify-content-between">
                  <div>
                    <div class="fw-bold small mb-1">Comfortable Message Spacing</div>
                    <div class="extra-small text-muted">Spacious chat bubbles with full avatar previews</div>
                  </div>
                  <div class="form-check form-switch fs-5 mb-0">
                    <input class="form-check-input" type="checkbox" id="settingsDensityToggle" checked>
                  </div>
                </div>
              </div>
            </div>

            <!-- PANE 4: SOUNDS & ALERTS -->
            <div class="tab-pane fade" id="pane-sound" role="tabpanel" tabindex="0">
              <div class="mb-3">
                <h5 class="fw-bold mb-1">Sounds & Notifications</h5>
                <p class="text-muted small mb-0">Control audio chimes and incoming message alerts</p>
              </div>

              <!-- Real-time Chime Card -->
              <div class="settings-card mb-3">
                <div class="d-flex align-items-center justify-content-between mb-3">
                  <div>
                    <div class="fw-bold small mb-1"><i class="bi bi-bell me-1 text-warning"></i> Incoming Message Audio Chime</div>
                    <div class="extra-small text-muted">Play a subtle 2-tone chime when new messages arrive</div>
                  </div>
                  <div class="form-check form-switch fs-5 mb-0">
                    <input class="form-check-input" type="checkbox" id="settingsSoundToggle" checked>
                  </div>
                </div>

                <div class="pt-3 border-top border-secondary border-opacity-10 d-flex align-items-center justify-content-between">
                  <div class="extra-small text-muted">Test sound playback with Web Audio Synthesizer:</div>
                  <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" id="testChimeBtn">
                    <i class="bi bi-play-fill me-1"></i> Test Chime
                  </button>
                </div>
              </div>

              <!-- Push Notifications -->
              <div class="settings-card">
                <div class="d-flex align-items-center justify-content-between">
                  <div>
                    <div class="fw-bold small mb-1"><i class="bi bi-app-indicator me-1 text-info"></i> Browser Desktop Notifications</div>
                    <div class="extra-small text-muted">Receive pop-ups when ChatIn is running in the background</div>
                  </div>
                  <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" id="requestPushBtn">
                    Enable
                  </button>
                </div>
              </div>
            </div>

            <!-- PANE 5: CHAT & SHORTCUTS -->
            <div class="tab-pane fade" id="pane-shortcuts" role="tabpanel" tabindex="0">
              <div class="mb-3">
                <h5 class="fw-bold mb-1">Chat & Keyboard Shortcuts</h5>
                <p class="text-muted small mb-0">Keyboard bindings and composer preferences</p>
              </div>

              <!-- Enter to Send -->
              <div class="settings-card mb-3">
                <div class="d-flex align-items-center justify-content-between">
                  <div>
                    <div class="fw-bold small mb-1"><i class="bi bi-keyboard me-1 text-success"></i> Press Enter to Send</div>
                    <div class="extra-small text-muted">When enabled, pressing <span class="keycap-badge">↵ Enter</span> sends message immediately. Use <span class="keycap-badge">Shift + Enter</span> for newlines.</div>
                  </div>
                  <div class="form-check form-switch fs-5 mb-0">
                    <input class="form-check-input" type="checkbox" id="settingsEnterToSendToggle" checked>
                  </div>
                </div>
              </div>

              <!-- Keyboard Shortcuts Table -->
              <div class="settings-card">
                <div class="fw-bold small mb-3"><i class="bi bi-command me-1 text-primary"></i> Keyboard Shortcuts Reference</div>
                <div class="d-flex flex-column gap-2">
                  <div class="d-flex align-items-center justify-content-between py-1 border-bottom border-secondary border-opacity-10">
                    <span class="small">Send message</span>
                    <div><span class="keycap-badge">↵ Enter</span></div>
                  </div>
                  <div class="d-flex align-items-center justify-content-between py-1 border-bottom border-secondary border-opacity-10">
                    <span class="small">Insert line break</span>
                    <div><span class="keycap-badge">⇧ Shift</span> + <span class="keycap-badge">↵ Enter</span></div>
                  </div>
                  <div class="d-flex align-items-center justify-content-between py-1 border-bottom border-secondary border-opacity-10">
                    <span class="small">Open user search</span>
                    <div><span class="keycap-badge">Ctrl</span> + <span class="keycap-badge">K</span></div>
                  </div>
                  <div class="d-flex align-items-center justify-content-between py-1">
                    <span class="small">Close open modal / dialog</span>
                    <div><span class="keycap-badge">Esc</span></div>
                  </div>
                </div>
              </div>
            </div>

            <!-- PANE 6: SYSTEM TELEMETRY -->
            <div class="tab-pane fade" id="pane-system" role="tabpanel" tabindex="0">
              <div class="mb-3">
                <h5 class="fw-bold mb-1">System & Telemetry</h5>
                <p class="text-muted small mb-0">Live engine performance, server connectivity, and cache</p>
              </div>

              <!-- Telemetry Metrics Card -->
              <div class="settings-card mb-3">
                <div class="row g-3">
                  <div class="col-6 col-md-3">
                    <div class="extra-small text-muted mb-1">Socket.IO State</div>
                    <div class="fw-bold small d-flex align-items-center gap-1 text-success">
                      <span class="status-dot connected" style="width:7px;height:7px;"></span> Connected
                    </div>
                  </div>
                  <div class="col-6 col-md-3">
                    <div class="extra-small text-muted mb-1">Server Latency</div>
                    <div class="fw-bold small text-primary" id="telemetryLatencyVal">-- ms</div>
                  </div>
                  <div class="col-6 col-md-3">
                    <div class="extra-small text-muted mb-1">Database Cluster</div>
                    <div class="fw-bold small text-body">MongoDB Atlas</div>
                  </div>
                  <div class="col-6 col-md-3">
                    <div class="extra-small text-muted mb-1">ChatIn Version</div>
                    <div class="fw-bold small text-body">v2.5.0 Pro</div>
                  </div>
                </div>

                <div class="pt-3 mt-3 border-top border-secondary border-opacity-10 d-flex align-items-center justify-content-between">
                  <span class="extra-small text-muted">Test real-time round-trip latency to Express API:</span>
                  <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" id="runLatencyTestBtn">
                    <i class="bi bi-speedometer2 me-1"></i> Ping Server
                  </button>
                </div>
              </div>

              <!-- Storage & Cache -->
              <div class="settings-card">
                <div class="d-flex align-items-center justify-content-between">
                  <div>
                    <div class="fw-bold small mb-1"><i class="bi bi-trash3 me-1 text-danger"></i> Reset Local Cache</div>
                    <div class="extra-small text-muted">Clears local storage preferences and cached UI state</div>
                  </div>
                  <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3" id="clearCacheBtn">
                    Clear Cache
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- MOBILE BOTTOM SHEET: MESSAGE CONTEXT OPTIONS & QUICK REACTIONS -->
