<%- include('partials/head', { title: 'Sign In — ChatIn', isChat: false }) %>

<div class="auth-page-wrapper d-flex align-items-center justify-content-center min-vh-100 p-3">
  <div class="auth-card p-4 p-md-5 rounded-4 shadow-lg position-relative">
    <!-- Top Bar with Home & Theme Toggle -->
    <div class="d-flex align-items-center justify-content-between mb-4">
      <a href="/" class="btn-back-home text-decoration-none small d-inline-flex align-items-center gap-1">
        <i class="bi bi-arrow-left"></i> Home
      </a>
      <button id="themeToggleBtn" class="btn-theme-toggle" aria-label="Toggle color theme" title="Toggle Theme">
        <i class="bi bi-sun" id="themeIcon"></i>
      </button>
    </div>

    <!-- Brand Header -->
    <div class="text-center mb-4">
      <a href="/" class="d-inline-flex align-items-center gap-2 text-decoration-none mb-3">
        <div class="chatin-logo-badge">
          <img src="/logo.svg" alt="ChatIn" width="44" height="44">
        </div>
        <span class="auth-brand-name">Chat<span class="text-primary">In</span></span>
      </a>
      <h3 class="auth-heading text-body">Welcome Back</h3>
      <p class="auth-sub small mb-0">Sign in to continue to your messages</p>
    </div>

    <!-- Error Alert Banner -->
    <div id="errorAlert" class="alert alert-danger d-none py-2 px-3 small rounded-3 mb-3" role="alert"></div>

    <!-- Login Form -->
    <form id="loginForm">
      <div class="mb-3">
        <label for="identifier" class="form-label small fw-semibold text-body">Email or Username</label>
        <div class="input-group custom-input-group">
          <span class="input-group-text border-end-0">
            <i class="bi bi-person fs-6"></i>
          </span>
          <input type="text" id="identifier" class="form-control border-start-0 ps-1" placeholder="Enter username or email" required autocomplete="username">
        </div>
      </div>

      <div class="mb-4">
        <label for="password" class="form-label small fw-semibold text-body">Password</label>
        <div class="input-group custom-input-group">
          <span class="input-group-text border-end-0">
            <i class="bi bi-lock fs-6"></i>
          </span>
          <input type="password" id="password" class="form-control border-start-0 border-end-0 ps-1" placeholder="Enter password" required autocomplete="current-password">
          <button class="btn border-start-0" type="button" id="togglePassword" title="Show/Hide Password">
            <i class="bi bi-eye fs-6" id="eyeIcon"></i>
          </button>
        </div>
      </div>

      <button type="submit" id="submitBtn" class="btn chatin-btn-gradient w-100 py-2 rounded-3 fw-semibold">
        <span id="btnText">Sign In</span>
        <span id="btnSpinner" class="spinner-border spinner-border-sm ms-2 d-none" role="status" aria-hidden="true"></span>
      </button>
    </form>

    <div class="text-center mt-4 pt-3 border-top border-secondary border-opacity-25">
      <p class="small text-muted mb-0">
        Don't have an account? <a href="/register" class="text-primary text-decoration-none fw-semibold ms-1">Create one free</a>
      </p>
      <div class="d-flex align-items-center justify-content-center gap-3 mt-3 extra-small text-muted">
        <span><i class="bi bi-shield-check text-success me-1"></i> End-to-End JWT</span>
        <span>•</span>
        <span><i class="bi bi-lightning-charge text-warning me-1"></i> Live Socket.IO</span>
      </div>
    </div>
  </div>
</div>

<script src="/js/auth.js"></script>
<%- include('partials/footer') %>