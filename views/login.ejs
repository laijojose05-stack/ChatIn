<%- include('partials/head', { title: 'Sign In — ChatIn', isChat: false }) %>

<div class="auth-page-wrapper d-flex align-items-center justify-content-center min-vh-100 p-3">
  <div class="auth-card p-4 p-md-5 rounded-4 shadow-lg">
    <!-- Brand Header -->
    <div class="text-center mb-4">
      <a href="/" class="d-inline-flex align-items-center gap-2 text-decoration-none mb-3">
        <div class="chatin-logo-badge">
          <img src="/logo.svg" alt="ChatIn" width="44" height="44">
        </div>
        <span class="auth-brand-name">Chat<span class="text-primary">In</span></span>
      </a>
      <h3 class="auth-heading">Welcome Back</h3>
      <p class="auth-sub text-muted small">Sign in to continue to your messages</p>
    </div>

    <!-- Error Alert Banner -->
    <div id="errorAlert" class="alert alert-danger d-none py-2 px-3 small rounded-3" role="alert"></div>

    <!-- Login Form -->
    <form id="loginForm">
      <div class="mb-3">
        <label for="identifier" class="form-label small fw-semibold">Email or Username</label>
        <div class="input-group">
          <span class="input-group-text bg-transparent border-end-0 text-muted">
            <i class="bi bi-person"></i>
          </span>
          <input type="text" id="identifier" class="form-control border-start-0" placeholder="Enter username or email" required autocomplete="username">
        </div>
      </div>

      <div class="mb-4">
        <label for="password" class="form-label small fw-semibold">Password</label>
        <div class="input-group">
          <span class="input-group-text bg-transparent border-end-0 text-muted">
            <i class="bi bi-lock"></i>
          </span>
          <input type="password" id="password" class="form-control border-start-0 border-end-0" placeholder="Enter password" required autocomplete="current-password">
          <button class="btn btn-outline-secondary border-start-0" type="button" id="togglePassword">
            <i class="bi bi-eye" id="eyeIcon"></i>
          </button>
        </div>
      </div>

      <button type="submit" id="submitBtn" class="btn chatin-btn-gradient w-100 py-2 rounded-3 fw-semibold">
        <span id="btnText">Sign In</span>
        <span id="btnSpinner" class="spinner-border spinner-border-sm ms-2 d-none" role="status" aria-hidden="true"></span>
      </button>
    </form>

    <div class="text-center mt-4 pt-2 border-top border-dark-subtle">
      <p class="small text-muted mb-0">
        Don't have an account? <a href="/register" class="text-primary text-decoration-none fw-semibold">Create one free</a>
      </p>
    </div>
  </div>
</div>

<script src="/js/auth.js"></script>
<%- include('partials/footer') %>
