<%- include('partials/head', { title: 'Create Account — ChatIn', isChat: false }) %>

<div class="auth-page-wrapper d-flex align-items-center justify-content-center min-vh-100 p-3 p-md-4">
  <div class="auth-split-card rounded-4 shadow-2xl overflow-hidden">
    <div class="row g-0">
      
      <!-- LEFT SHOWCASE PANEL (Desktop & Tablet) -->
      <div class="col-lg-5 d-none d-lg-flex flex-column justify-content-between p-4 p-xl-5 auth-showcase-panel">
        <div>
          <!-- Brand Header -->
          <a href="/" class="d-inline-flex align-items-center gap-2 text-decoration-none mb-5">
            <div class="chatin-logo-badge">
              <img src="/logo.svg" alt="ChatIn" width="36" height="36">
            </div>
            <span class="auth-brand-name">Chat<span class="text-primary">In</span></span>
          </a>

          <h2 class="showcase-title fw-bold mb-3">
            Real-time conversations,<br>
            <span class="gradient-text">effortlessly simple.</span>
          </h2>
          <p class="showcase-desc text-muted mb-4">
            Connect instantly with friends, teammates, and communities with sub-second Socket.IO delivery and zero clutter.
          </p>

          <!-- Feature Bullets -->
          <div class="showcase-features d-flex flex-column gap-3 mb-4">
            <div class="d-flex align-items-center gap-3">
              <div class="showcase-icon-pill">
                <i class="bi bi-lightning-charge-fill text-warning"></i>
              </div>
              <span class="small fw-semibold">Sub-50ms instant bidirectional messaging</span>
            </div>
            <div class="d-flex align-items-center gap-3">
              <div class="showcase-icon-pill">
                <i class="bi bi-shield-check text-success"></i>
              </div>
              <span class="small fw-semibold">bcrypt salted passwords & stateless JWT security</span>
            </div>
            <div class="d-flex align-items-center gap-3">
              <div class="showcase-icon-pill">
                <i class="bi bi-people-fill text-info"></i>
              </div>
              <span class="small fw-semibold">Dynamic group channels with admin governance</span>
            </div>
            <div class="d-flex align-items-center gap-3">
              <div class="showcase-icon-pill">
                <i class="bi bi-moon-stars-fill text-primary"></i>
              </div>
              <span class="small fw-semibold">Adaptive Light and Dark theme modes</span>
            </div>
          </div>
        </div>

        <!-- Social Proof Footer -->
        <div class="showcase-footer pt-4 border-top border-secondary border-opacity-25">
          <div class="d-flex align-items-center gap-3">
            <div class="avatar-stack d-flex">
              <div class="stacked-avatar bg-primary">LJ</div>
              <div class="stacked-avatar bg-success">GN</div>
              <div class="stacked-avatar bg-info">AD</div>
              <div class="stacked-avatar bg-warning text-dark">+</div>
            </div>
            <div>
              <div class="small fw-bold">Live Real-Time Network</div>
              <div class="extra-small text-muted">Join active conversations today</div>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT FORM PANEL -->
      <div class="col-lg-7 p-4 p-md-5 auth-form-panel d-flex flex-column justify-content-center">
        <!-- Top Navigation Bar -->
        <div class="d-flex align-items-center justify-content-between mb-4">
          <a href="/" class="btn-back-home text-muted text-decoration-none small d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Home
          </a>
          <button id="themeToggleBtn" class="btn-theme-toggle" aria-label="Toggle color theme" title="Toggle Theme">
            <i class="bi bi-sun" id="themeIcon"></i>
          </button>
        </div>

        <!-- Mobile Brand (Visible only on small screens) -->
        <div class="d-lg-none text-center mb-4">
          <a href="/" class="d-inline-flex align-items-center gap-2 text-decoration-none mb-2">
            <img src="/logo.svg" alt="ChatIn" width="36" height="36">
            <span class="auth-brand-name">Chat<span class="text-primary">In</span></span>
          </a>
        </div>

        <!-- Header -->
        <div class="mb-4">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <h3 class="auth-heading fw-bold mb-1">Create your account</h3>
              <p class="auth-sub text-muted small mb-0">Fill in your details to start chatting in seconds</p>
            </div>
            <!-- Dynamic Avatar Preview -->
            <div class="avatar-live-preview" id="avatarPreview" title="Your live profile initials">
              CI
            </div>
          </div>
        </div>

        <!-- Error / Notification Alert -->
        <div id="errorAlert" class="alert alert-danger d-none py-2 px-3 small rounded-3 mb-3" role="alert">
          <i class="bi bi-exclamation-triangle-fill me-2"></i>
          <span id="errorText"></span>
        </div>

        <!-- Registration Form -->
        <form id="registerForm" novalidate>
          <!-- 1. Username Field -->
          <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <label for="username" class="form-label small fw-semibold mb-0">Username</label>
              <span class="extra-small text-muted" id="usernameHint">3–30 characters</span>
            </div>
            <div class="input-group custom-input-group">
              <span class="input-group-text bg-transparent border-end-0 text-muted">
                <i class="bi bi-at fs-6"></i>
              </span>
              <input 
                type="text" 
                id="username" 
                name="username" 
                class="form-control border-start-0 ps-1" 
                placeholder="e.g. alex_dev" 
                required 
                minlength="3" 
                maxlength="30" 
                autocomplete="username"
                spellcheck="false"
              >
              <span class="input-group-text bg-transparent border-start-0 text-muted d-none" id="usernameStatusIcon">
                <i class="bi bi-check-circle-fill text-success"></i>
              </span>
            </div>
            <div class="invalid-feedback extra-small d-block d-none" id="usernameFeedback"></div>
          </div>

          <!-- 2. Email Address Field -->
          <div class="mb-3">
            <label for="email" class="form-label small fw-semibold mb-1">Email Address</label>
            <div class="input-group custom-input-group">
              <span class="input-group-text bg-transparent border-end-0 text-muted">
                <i class="bi bi-envelope fs-6"></i>
              </span>
              <input 
                type="email" 
                id="email" 
                name="email" 
                class="form-control border-start-0 ps-1" 
                placeholder="alex@example.com" 
                required 
                autocomplete="email"
              >
              <span class="input-group-text bg-transparent border-start-0 text-muted d-none" id="emailStatusIcon">
                <i class="bi bi-check-circle-fill text-success"></i>
              </span>
            </div>
            <div class="invalid-feedback extra-small d-block d-none" id="emailFeedback"></div>
          </div>

          <!-- 3. Password Field with Live Strength Indicator -->
          <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <label for="password" class="form-label small fw-semibold mb-0">Password</label>
              <span class="extra-small text-muted" id="strengthText">Strength: None</span>
            </div>
            <div class="input-group custom-input-group">
              <span class="input-group-text bg-transparent border-end-0 text-muted">
                <i class="bi bi-lock fs-6"></i>
              </span>
              <input 
                type="password" 
                id="password" 
                name="password" 
                class="form-control border-start-0 border-end-0 ps-1" 
                placeholder="Create a strong password" 
                required 
                minlength="6" 
                autocomplete="new-password"
              >
              <button class="btn btn-outline-secondary border-start-0" type="button" id="togglePassword" title="Show/Hide Password">
                <i class="bi bi-eye" id="eyeIcon"></i>
              </button>
            </div>

            <!-- Password Strength Bar -->
            <div class="password-strength-container mt-2">
              <div class="progress" style="height: 4px; background: rgba(255,255,255,0.08);">
                <div id="strengthMeter" class="progress-bar" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
              </div>
            </div>

            <!-- Password Requirements Checklist -->
            <div class="d-flex gap-3 mt-2 extra-small text-muted" id="passwordRules">
              <span id="ruleLength"><i class="bi bi-circle me-1"></i> Min 6 characters</span>
              <span id="ruleComplexity"><i class="bi bi-circle me-1"></i> Number or symbol</span>
            </div>
          </div>

          <!-- 4. Confirm Password Field -->
          <div class="mb-4">
            <label for="confirmPassword" class="form-label small fw-semibold mb-1">Confirm Password</label>
            <div class="input-group custom-input-group">
              <span class="input-group-text bg-transparent border-end-0 text-muted">
                <i class="bi bi-shield-check fs-6"></i>
              </span>
              <input 
                type="password" 
                id="confirmPassword" 
                class="form-control border-start-0 border-end-0 ps-1" 
                placeholder="Re-enter your password" 
                required 
                autocomplete="new-password"
              >
              <button class="btn btn-outline-secondary border-start-0" type="button" id="toggleConfirmPassword" title="Show/Hide Password">
                <i class="bi bi-eye" id="eyeIconConfirm"></i>
              </button>
            </div>
            <div class="extra-small mt-1 d-none" id="matchFeedback"></div>
          </div>

          <!-- Terms Checkbox -->
          <div class="form-check mb-4">
            <input class="form-check-input" type="checkbox" id="termsCheck" required checked>
            <label class="form-check-label extra-small text-muted" for="termsCheck">
              I agree to the <a href="#" class="text-decoration-none text-primary">Terms of Service</a> and <a href="#" class="text-decoration-none text-primary">Privacy Policy</a>
            </label>
          </div>

          <!-- Submit Button -->
          <button type="submit" id="submitBtn" class="btn chatin-btn-gradient w-100 py-2 rounded-3 fw-semibold shadow-sm">
            <span id="btnText">Create ChatIn Account</span>
            <span id="btnSpinner" class="spinner-border spinner-border-sm ms-2 d-none" role="status" aria-hidden="true"></span>
          </button>
        </form>

        <!-- Form Footer Link -->
        <div class="text-center mt-4 pt-3 border-top border-secondary border-opacity-10">
          <p class="small text-muted mb-0">
            Already have an account? 
            <a href="/login" class="text-primary text-decoration-none fw-semibold ms-1">
              Sign in <i class="bi bi-arrow-right-short"></i>
            </a>
          </p>
        </div>
      </div>

    </div>
  </div>
</div>

<script src="/js/auth.js"></script>
<%- include('partials/footer') %>
