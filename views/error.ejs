<%- include('partials/head', { title: typeof title !== 'undefined' ? title : 'Error - ChatIn', isChat: false }) %>
<%- include('partials/navbar') %>

<div class="container text-center py-5 my-5">
  <div class="py-5">
    <div class="display-1 fw-bold text-danger">⚠️</div>
    <h2 class="mb-3"><%= typeof message !== 'undefined' ? message : 'An unexpected error occurred' %></h2>
    <p class="text-muted mb-4">We encountered an issue processing your request. Please try again or return home.</p>
    <% if (typeof error !== 'undefined' && error && error.stack) { %>
      <div class="text-start bg-body-tertiary p-3 rounded-3 mb-4 mx-auto" style="max-width: 600px; overflow-x: auto;">
        <pre class="small text-danger mb-0"><code><%= error.stack %></code></pre>
      </div>
    <% } %>
    <a href="/" class="btn chatin-btn-gradient rounded-pill px-4 py-2">
      <i class="bi bi-house me-1"></i> Return Home
    </a>
  </div>
</div>

<%- include('partials/footer') %>